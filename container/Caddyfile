# landing's own Caddy, inside the container (not infra's edge Caddy).
# Contract: CLAUDE.md, infra/docs/CONVENTIONS.md §4–5, INTEGRATION.md §2 and §8.
#
#   /healthz (any host)                              -> 200 {"status":"ok"}
#   Host portal.SITE_DOMAIN, any path                -> X-Proxy-Secret required, else 401
#   Any other host: /portal/*, /me.json, /apps.json  -> X-Proxy-Secret required, else 401
#   Host portal.SITE_DOMAIN /install                 -> portal/install.html (the install page, after the gate)
#   Host SITE_DOMAIN / www: those portal paths and /install -> 404
#   /manifest.webmanifest, /sw.js, /offline.html, /pwa-icons/<app>/<icon>  -> PUBLIC on every host, the portal host
#                                                    included (no secret): they are fetched before sign-in and
#                                                    hold nothing about a person. On the portal host the manifest is
#                                                    portal/manifest.webmanifest (name "2972 Portal").
#   Everything else                                  -> the public static site (identity ignored)
#   /content/content.json, /media/<id>-<w>.webp      -> published content (read-only mounts), any host
#   /img/drive/<drive id>-<w>.webp                   -> Drive photos saved at image build time (public and direct hosts)
#
# The secret check is a plain header match, not constant-time. CONVENTIONS §4 allows this for
# landing: it is reachable only on the Docker network and guards only the viewer's own identity.
# entrypoint.sh refuses an empty secret, one under 16 chars, or anything but [A-Za-z0-9_-].
#
# Gated parts use `route` so the 401 runs first. (Outside `route`, Caddy runs `handle` before
# `respond`, which would skip the gate.)

{
	admin off
	auto_https off
	persist_config off
}

# 401 unless the request came through infra's Caddy. Import only inside `route`.
(gate) {
	@no_secret not header X-Proxy-Secret {$PROXY_SHARED_SECRET}
	respond @no_secret "Unauthorized" 401
}

# config.js is rendered from env SITE_SCHEME / SITE_DOMAIN.
(config_js) {
	handle /config.js {
		header Cache-Control "no-cache"
		templates {
			mime text/javascript application/javascript
		}
		file_server
	}
}

# Files that make the site installable as an app. Public on every host: a browser fetches them before anyone
# signs in, and none holds anything about a person. Only these exact files are served; nothing else under
# /pwa-icons. Import these BEFORE the gate on the portal host.
(pwa_public) {
	handle /sw.js {
		header Cache-Control "no-cache"
		header Content-Type "text/javascript; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	handle /offline.html {
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex"
		file_server
	}
	@pwa_icons path_regexp icons ^/pwa-icons/(site|portal|tasks|admin|kickoff)/(icon\.svg|icon-192\.png|icon-512\.png|maskable-512\.png|apple-touch-icon\.png)$
	handle @pwa_icons {
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	@pwa_other path /pwa-icons /pwa-icons/*
	respond @pwa_other 404
}

# Published content from the site editor, in read-only mounts (see Dockerfile):
#   /srv/content/content.json   the published site content (the editor writes it atomically)
#   /srv/media/<id>-<w>.webp    uploaded images (id = 20 hex characters, w = 400, 800 or 1600)
# Only those two shapes are served, so a half-written temp file or anything else in the volumes
# stays private. A missing file is a plain 404, and the page then uses its built-in content.
(published) {
	@content path /content/content.json
	handle @content {
		root * /srv
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	# The immutable cache header goes only on files that exist: a missing image must not be remembered
	# as "not found" for a year (a later upload under that name would never show).
	@media {
		path_regexp media ^/media/[a-f0-9]{20}-(400|800|1600)\.webp$
		file {
			root /srv
			try_files {http.request.uri.path}
		}
	}
	handle @media {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	@published_other path /content /content/* /media /media/*
	respond @published_other 404
}

# Google Drive photos downloaded when the image was built (scripts/drive-photos/fetch.cjs), so pages do not
# wait on lh3.googleusercontent.com. The name holds the Drive ID, and a changed photo gets a new ID, so a
# file never changes: cache it for a year. As with /media, only files that exist get that header, and only
# this one name shape is served (the manifest reaches pages through /config.js instead).
(drive_photos) {
	@drive_photo {
		path_regexp drive ^/img/drive/[A-Za-z0-9_-]{20,}-(400|800|1200|1600)\.webp$
		file {
			try_files {http.request.uri.path}
		}
	}
	handle @drive_photo {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	@drive_other path /img/drive /img/drive/*
	respond @drive_other 404
}

# Identity and tiles. Import only after the gate.
# no-store on everything behind login, so after sign-out the browser can't show a stored
# (or back/forward-cached) portal page with the old name and tiles.
(portal_files) {
	header X-Robots-Tag "noindex, nofollow"
	header Cache-Control "no-store"
	handle /me.json {
		root * /srv/templates
		templates {
			mime application/json
		}
		file_server
	}
	handle /apps.json {
		root * /config
		file_server
	}
}

:{$PORT} {
	root * /srv/site

	handle /healthz {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# ---- Portal host: gated as a whole ----
	@portal_host host portal.{$SITE_DOMAIN}
	handle @portal_host {
		route {
			import pwa_public
			handle /manifest.webmanifest {
				rewrite * /portal/manifest.webmanifest
				header Content-Type "application/manifest+json"
				header Cache-Control "no-cache"
				file_server
			}
			import gate
			import portal_files
			import config_js
			import published
			handle /portal/* {
				file_server
			}
			@install path /install /install/
			handle @install {
				rewrite * /portal/install.html
				file_server
			}
			@shared path /css/* /js/* /assets/* /fonts/* /brand/*
			handle @shared {
				file_server
			}
			handle / {
				rewrite * /portal/index.html
				file_server
			}
			# Public pages belong on the public host.
			handle {
				redir {$SITE_SCHEME}://{$SITE_DOMAIN}{uri} 302
			}
		}
	}

	# ---- Public hosts: never serve portal files or identity ----
	@public_host host {$SITE_DOMAIN} www.{$SITE_DOMAIN}
	handle @public_host {
		route {
			@portal_paths path /portal /portal/* /install /install/ /me.json /apps.json
			respond @portal_paths 404
			redir /team-login.html {$SITE_SCHEME}://portal.{$SITE_DOMAIN}/ 302
			redir /team.html /mentor.html 301
			import pwa_public
			handle /manifest.webmanifest {
				header Content-Type "application/manifest+json"
				header Cache-Control "no-cache"
				file_server
			}
			import config_js
			import published
			import drive_photos
			file_server
		}
	}

	# ---- Any other host (direct requests such as landing:3001) ----
	handle {
		route {
			@install_direct path /install /install/
			handle @install_direct {
				route {
					import gate
					import portal_files
					rewrite * /portal/install.html
					file_server
				}
			}
			@portal_paths_direct path /portal /portal/* /me.json /apps.json
			handle @portal_paths_direct {
				route {
					import gate
					import portal_files
					file_server
				}
			}
			import pwa_public
			handle /manifest.webmanifest {
				header Content-Type "application/manifest+json"
				header Cache-Control "no-cache"
				file_server
			}
			import config_js
			import published
			import drive_photos
			file_server
		}
	}
}
