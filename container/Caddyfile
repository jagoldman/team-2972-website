# landing's own Caddy, inside the container (not infra's edge Caddy).
# Contract: CLAUDE.md, infra/docs/CONVENTIONS.md §4–5, INTEGRATION.md §2 and §8.
#
#   /healthz (any host)                              -> 200 {"status":"ok"}
#   Host portal.SITE_DOMAIN, any path                -> X-Proxy-Secret required, else 401
#   Any other host: /portal/*, /me.json, /apps.json  -> X-Proxy-Secret required, else 401
#   Host SITE_DOMAIN / www: those portal paths       -> 404
#   Everything else                                  -> the public static site (identity ignored)
#
# The secret check is a plain header match, not constant-time. CONVENTIONS §4 allows this for
# landing: it is reachable only on the Docker network and guards only the viewer's own identity.
# entrypoint.sh refuses an empty secret, one under 16 chars, or anything but [A-Za-z0-9_-].
#
# Gated parts use `route` so the 401 runs first. (Outside `route`, Caddy runs `handle` before
# `respond`, which would skip the gate.)

{
	admin off
	auto_https off
	persist_config off
}

# 401 unless the request came through infra's Caddy. Import only inside `route`.
(gate) {
	@no_secret not header X-Proxy-Secret {$PROXY_SHARED_SECRET}
	respond @no_secret "Unauthorized" 401
}

# config.js is rendered from env SITE_SCHEME / SITE_DOMAIN.
(config_js) {
	handle /config.js {
		header Cache-Control "no-cache"
		templates {
			mime text/javascript application/javascript
		}
		file_server
	}
}

# Identity and tiles. Import only after the gate.
(portal_files) {
	header X-Robots-Tag "noindex, nofollow"
	handle /me.json {
		root * /srv/templates
		header Cache-Control "no-store"
		templates {
			mime application/json
		}
		file_server
	}
	handle /apps.json {
		root * /config
		header Cache-Control "no-cache"
		file_server
	}
}

:{$PORT} {
	root * /srv/site

	handle /healthz {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# ---- Portal host: gated as a whole ----
	@portal_host host portal.{$SITE_DOMAIN}
	handle @portal_host {
		route {
			import gate
			import config_js
			import portal_files
			handle /portal/* {
				file_server
			}
			@shared path /css/* /js/* /assets/*
			handle @shared {
				file_server
			}
			handle / {
				rewrite * /portal/index.html
				file_server
			}
			# Public pages belong on the public host.
			handle {
				redir {$SITE_SCHEME}://{$SITE_DOMAIN}{uri} 302
			}
		}
	}

	# ---- Public hosts: never serve portal files or identity ----
	@public_host host {$SITE_DOMAIN} www.{$SITE_DOMAIN}
	handle @public_host {
		route {
			@portal_paths path /portal /portal/* /me.json /apps.json
			respond @portal_paths 404
			redir /team-login.html {$SITE_SCHEME}://portal.{$SITE_DOMAIN}/ 302
			import config_js
			file_server
		}
	}

	# ---- Any other host (direct requests such as landing:3001) ----
	handle {
		route {
			@portal_paths_direct path /portal /portal/* /me.json /apps.json
			handle @portal_paths_direct {
				route {
					import gate
					import portal_files
					file_server
				}
			}
			import config_js
			file_server
		}
	}
}
