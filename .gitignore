# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Images are hosted on Google Drive (see README) — don't commit local photo/video files.
# Placeholder SVGs in assets/ are still tracked.
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.heic
*.HEIC
*.JPG
*.JPEG
*.PNG
*.mov
*.MOV
*.mp4

# The app icons (pwa-icons/) are drawn by build-icons.cjs, not photos, so their PNGs are tracked.
!/pwa-icons/**/*.png

# The team logo (a drawing, not a photo; the user asked for it to be a file in the site) and its small copy for the header.
!/brand/team-2972-logo.png
!/brand/team-2972-logo-256.png

# Drive photos downloaded by scripts/drive-photos/fetch.cjs (at image build time, or by hand), and its packages.
/img/drive/
/scripts/drive-photos/node_modules/

# --- 2972 standard: never commit secrets or data (infra/docs/CONVENTIONS.md §9) ---
.env
.env.*
!.env.example
backups/
data/
*.sql.gz
*.dump
*.pem
*.key
/test-results/
/playwright-report/
/.claude/worktrees/
