# For running the landing container alone (see test/container-test.sh).
# In the stack these come from infra/.env through infra/compose.yml. Names only, no real values.

# Port inside the container (always 3001 in the stack)
PORT=3001
# localhost for local dev, 2972robotics.com in production
SITE_DOMAIN=localhost
# http for local dev, https in production
SITE_SCHEME=http
# Shared with infra's Caddy, which sends it as X-Proxy-Secret. 16+ chars, no * or spaces.
PROXY_SHARED_SECRET=
